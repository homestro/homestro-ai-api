{
  "$schema": "https://extensions.shopifycdn.com/shopifycloud/schemas/v1/shopify-intent.json",
  "inputSchema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "description": "German product title for Homestro",
        "minLength": 1,
        "maxLength": 255
      },
      "source_url": {
        "type": "string",
        "format": "uri",
        "description": "Supplier or source URL for the product"
      },
      "cost": {
        "type": "number",
        "minimum": 0,
        "description": "Supplier purchase cost in EUR"
      },
      "selling_price": {
        "type": "number",
        "minimum": 0,
        "description": "Planned selling price in EUR"
      },
      "category": {
        "type": "string",
        "description": "Homestro category"
      },
      "description": {
        "type": "string",
        "description": "Optional source description or product notes"
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "id": {
        "$ref": "https://extensions.shopifycdn.com/shopifycloud/schemas/v1/shopify/product/gid.json"
      }
    }
  }
}
