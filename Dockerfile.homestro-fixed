FROM node:20-bookworm-slim
# HOMESTRO CLEAN CATALOG START 2026-09-18
# RAILWAY DIRECT SERVER FIX 2026-09-18
# Playwright runtime: use Debian Chromium, never bundled Chromium.
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl chromium \
  && chromium --version \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package*.json ./
ENV NODE_ENV=production
ENV PORT=8080
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
ENV CHROMIUM_PATH=/usr/bin/chromium
RUN npm install --omit=dev
COPY . .
CMD ["node", "./server.js"]
