FROM node:20-bookworm-slim
# HOMESTRO CLEAN CATALOG START 2026-09-18
# RAILWAY DIRECT SERVER FIX 2026-09-18
# FORCE DRAFT AUTOPILOT IMAGE REBUILD 2026-09-30
# Playwright runtime: use Debian Chromium, never bundled Chromium.
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl chromium ffmpeg fonts-dejavu-core tesseract-ocr tesseract-ocr-eng python3 python3-venv python3-pip \
  && chromium --version && ffmpeg -version && ffprobe -version \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package*.json ./
ENV NODE_ENV=production
ENV PORT=8080
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
ENV CHROMIUM_PATH=/usr/bin/chromium
RUN npm install --omit=dev
COPY . .
RUN python3 -m venv /opt/venv \
  && /opt/venv/bin/pip install --no-cache-dir "httpx>=0.27,<1" "pydantic>=2.9,<3" "defusedxml>=0.7.1,<1" "Pillow>=10,<13"
RUN node --check ./organic-catalog.js \
  && node --check ./organic-marketing.js \
  && python3 -m py_compile ./agents/product_hunter.py ./jarvis_agents/unified_pipeline.py
ENV PYTHON_EXECUTABLE=/opt/venv/bin/python
# Autopilot quality logic is integrated directly in server.js/autopilot-core.js.
# Apply a deterministic Apify budget/cache guard before syntax validation so Hunter cannot create runaway paid Actor runs.
RUN node ./patch-apify-cost-guard.js && node ./test-quality-repair.js && node --check ./server.js && node --check ./autopilot-core.js
CMD ["node", "./server.js"]
