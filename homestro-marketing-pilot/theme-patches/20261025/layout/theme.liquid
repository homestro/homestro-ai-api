<!doctype html><html class="no-js" lang="{{ request.locale.iso_code }}"><head>
   {%- include 'tapita-seo-schema' -%}   
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#0b0b0b"><link rel="canonical" href="{{ canonical_url }}"><title>{{ page_title }}{% unless page_title contains shop.name %} – {{ shop.name }}{% endunless %}</title>{% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}{{ content_for_header }}{{ 'theme.css' | asset_url | stylesheet_tag }}{{ 'homestro-design-b.css' | asset_url | stylesheet_tag }}<script src="{{ 'theme.js' | asset_url }}" defer></script>
{% if request.page_type == 'product' %}
<script type="application/ld+json">{{ product | structured_data }}</script>
{% endif %}
</head><body><a class="skip-link" href="#MainContent">Zum Inhalt springen</a>{% sections 'header-group' %}<main id="MainContent" tabindex="-1">{{ content_for_layout }}</main>{% sections 'footer-group' %}<div id="toast" class="toast" role="status" aria-live="polite"></div></body></html>
