# Required to expose any authenticated endpoint; store only in the hosting secret manager.
PILOT_ADMIN_KEY=

# Paid Meta campaign gates. Defaults stay fail-closed; production pilot cap is €5/day.
PILOT_AD_DRY_RUN=true
PILOT_AD_MAX_BUDGET_EUR=0
DRY_RUN=true
ALLOW_MICRO_BUDGET=false
META_PRODUCT_CATALOG_ID=
META_PRODUCT_SET_ID=
META_PURCHASE_EVENT_VERIFIED=false
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PIXEL_ID=
META_PAGE_ID=
META_DSA_BENEFICIARY=
META_DSA_PAYOR=
META_API_VERSION=v26.0
META_BILLING_VERIFIED=false
PILOT_AUTOPILOT_ENABLED=false
PILOT_AUTOPILOT_INTERVAL_HOURS=12

# Optional creative generation; calls text and image APIs and may incur provider charges.
PILOT_CREATIVE_ENABLED=false
OPENAI_API_KEY=
PILOT_LLM_MODEL=gpt-4.1-mini
PILOT_IMAGE_MODEL=gpt-image-1
PILOT_CREATIVE_MIN_SCORE=85
# Campaign eligibility is catalog-wide; there is no fixed single-product ID.
PILOT_CREATIVE_DIR=/data/adtech-creatives
HOMESTRO_LOGO_URL=
HOMESTRO_BRAND_PRIMARY=#246B4B
HOMESTRO_BRAND_SECONDARY=#F2EFE7
HOMESTRO_BRAND_ACCENT=#D8A83E

# Optional official public Ad Library access. No scraper fallback is included.
META_AD_LIBRARY_ACCESS_TOKEN=
META_GRAPH_VERSION=v26.0
GMC_MERCHANT_ID=
GMC_SERVICE_ACCOUNT_JSON=

# Mount a persistent volume for aggregate campaign-plan audit records.
PILOT_AUDIT_DB_PATH=/data/adtech-pilot/audit.sqlite3

# Reuse the existing Shopify app credentials; do not create a second installation.
# In Railway use service reference variables to homestro-ai-api-fixed-current.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07
# Optional separate manual-trigger token; defaults to the existing PILOT_ADMIN_KEY.
PILOT_TRIGGER_TOKEN=
# Purchase watchdog is always fail-closed; it cannot be disabled by an env switch.
# Actual Meta metrics never imply attributable margin or permission to scale.
