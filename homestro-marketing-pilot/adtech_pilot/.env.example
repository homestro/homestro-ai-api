# Required to expose any authenticated endpoint; store only in the hosting secret manager.
PILOT_ADMIN_KEY=

# Paid Meta campaign gates. Defaults stay fail-closed; production pilot cap is €5/day.
PILOT_AD_DRY_RUN=true
PILOT_AD_MAX_BUDGET_EUR=0
DRY_RUN=true
ALLOW_MICRO_BUDGET=false
META_PRODUCT_CATALOG_ID=
META_PRODUCT_SET_ID=
META_PURCHASE_EVENT_VERIFIED=false
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PIXEL_ID=
META_PAGE_ID=
META_DSA_BENEFICIARY=
META_DSA_PAYOR=
META_API_VERSION=v26.0
META_BILLING_VERIFIED=false
PILOT_AUTOPILOT_ENABLED=false
PILOT_AUTOPILOT_INTERVAL_HOURS=12

# Optional creative generation; calls text and image APIs and may incur provider charges.
PILOT_CREATIVE_ENABLED=false
OPENAI_API_KEY=
PILOT_LLM_MODEL=gpt-4.1-mini
PILOT_IMAGE_MODEL=gpt-image-1
PILOT_CREATIVE_MIN_SCORE=85
# Campaign eligibility is catalog-wide; there is no fixed single-product ID.
PILOT_CREATIVE_DIR=/data/adtech-creatives
HOMESTRO_LOGO_URL=
HOMESTRO_BRAND_PRIMARY=#246B4B
HOMESTRO_BRAND_SECONDARY=#F2EFE7
HOMESTRO_BRAND_ACCENT=#D8A83E

# Optional official public Ad Library access. No scraper fallback is included.
META_AD_LIBRARY_ACCESS_TOKEN=
META_GRAPH_VERSION=v26.0
GMC_MERCHANT_ID=
GMC_SERVICE_ACCOUNT_JSON=

# Mount a persistent volume for aggregate campaign-plan audit records.
PILOT_AUDIT_DB_PATH=/data/adtech-pilot/audit.sqlite3

# Reuse the existing Shopify app credentials; do not create a second installation.
# In Railway use service reference variables to homestro-ai-api-fixed-current.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07
# Optional separate manual-trigger token; defaults to the existing PILOT_ADMIN_KEY.
PILOT_TRIGGER_TOKEN=
# Purchase watchdog is always fail-closed; it cannot be disabled by an env switch.
# Actual Meta metrics never imply attributable margin or permission to scale.

# Alternative mode: no Meta catalog access or Higgsfield generation is required.
PILOT_AD_MODE=website_sales
PILOT_PURCHASE_SOURCE=shopify_webhook
PILOT_PAYMENT_DB_PATH=/data/adtech-pilot/payments.sqlite3
PILOT_PUBLIC_ORIGIN=https://homestro-adtech-pilot-production.up.railway.app
# Merchant-admin webhook signing secret, NOT the app's client secret:
SHOPIFY_WEBHOOK_SECRET=

# Existing-ad product exploration (no paid AI generation, no budget writes).
PILOT_BRAIN_ENABLED=false
# Requires live website_sales bounded test. Rotates at most once/24h after >=2.50EUR experiment spend.
# Meta-reported ROAS is provisional; it never proves profit or authorizes spend increases.

# Optional separate HMAC key for experiment links; defaults to existing PILOT_ADMIN_KEY.
# Keep stable: old attribution links cannot be verified after changing the key.
PILOT_ATTRIBUTION_SECRET=
# Unit costs synchronize using existing Shopify credentials. No scopes/tokens are reset.
# Carrier fulfillment/payment/return/other costs require actual records, never default zero.

# Current strict owner policy: no unverified measurement spending.
PILOT_LAUNCH_POLICY=prove_it_first
PILOT_ACCEPT_UNVERIFIED_MEASUREMENT=false
# Validation is optional and never creates a Google campaign or budget.
GOOGLE_ADS_VALIDATE_ONLY_ENABLED=false

# Exact Microsoft Country location IDs for DE/AT from account setup; no inferred/display-name IDs.
# JSON object of DE and AT to numeric ID strings. All entities remain paused.
MICROSOFT_ADS_COUNTRY_LOCATION_IDS_JSON=
