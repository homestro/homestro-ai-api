# Required to expose any authenticated endpoint; store only in the hosting secret manager.
PILOT_ADMIN_KEY=

# Hard spend guard. These defaults must stay fail-closed.
PILOT_AD_DRY_RUN=true
PILOT_AD_MAX_BUDGET_EUR=0
DRY_RUN=True
ALLOW_MICRO_BUDGET=false
MICRO_BUDGET_PRODUCT_ID=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PIXEL_ID=
META_PAGE_ID=
META_DSA_BENEFICIARY=
META_DSA_PAYOR=
META_API_VERSION=v26.0
META_BILLING_VERIFIED=false
META_PURCHASE_EVENT_VERIFIED=false
PILOT_AUTOPILOT_ENABLED=false
PILOT_AUTOPILOT_INTERVAL_HOURS=12

# Optional creative generation; calls text and image APIs and may incur provider charges.
PILOT_CREATIVE_ENABLED=false
OPENAI_API_KEY=
PILOT_LLM_MODEL=gpt-4.1-mini
PILOT_IMAGE_MODEL=gpt-image-1
PILOT_CREATIVE_MIN_SCORE=85
ALLOW_MICRO_BUDGET=false
MICRO_BUDGET_PRODUCT_ID=
PILOT_CREATIVE_DIR=/data/adtech-creatives
HOMESTRO_LOGO_URL=
HOMESTRO_BRAND_PRIMARY=#246B4B
HOMESTRO_BRAND_SECONDARY=#F2EFE7
HOMESTRO_BRAND_ACCENT=#D8A83E

# Optional official public Ad Library access. No scraper fallback is included.
META_AD_LIBRARY_ACCESS_TOKEN=
META_GRAPH_VERSION=v26.0
GMC_MERCHANT_ID=
GMC_SERVICE_ACCOUNT_JSON=

# Mount a persistent volume for aggregate campaign-plan audit records.
PILOT_AUDIT_DB_PATH=/data/adtech-pilot/audit.sqlite3
