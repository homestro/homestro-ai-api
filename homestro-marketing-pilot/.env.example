# Mount a persistent Railway volume at /data; never use ephemeral /tmp for published assets.
PILOT_DATA_DIR=/data/marketing
PILOT_MEDIA_HOSTS=cdn.shopify.com
PILOT_WORKER_ENABLED=false
PILOT_PUBLISH_ENABLED=false
PILOT_FEED_ENABLED=false
PILOT_MAX_DAILY_POSTS=2
PILOT_FEED_MAX_OFFERS=50
PILOT_PAYMENT_FEE_RATE=0
# Add EU countries at 14.99 ONLY after matching Shopify checkout zones are active.
PILOT_SHIPPING_JSON=[{"country":"DE","price":6.99,"freeFrom":50}]

# Optional organic TikTok/Pinterest connector: off until owner OAuth is complete.
# No extra provider subscription: keep only two connected accounts, no card.
