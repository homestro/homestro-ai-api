<header class="collection-hero"><div class="page-width"><div class="eyebrow">HOMESTRO Kollektion</div><h1 class="section-title">{{ collection.title }}</h1>{% if collection.description != blank %}<div class="section-subtitle" style="margin:15px auto">{{ collection.description }}</div>{% endif %}</div></header><section class="section"><div class="page-width collection-layout"><aside class="filters"><strong>Filtern</strong>{% for filter in collection.filters %}<details open><summary>{{ filter.label }}</summary>{% for value in filter.values %}<label><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %}> {{ value.label }} ({{ value.count }})</label>{% endfor %}</details>{% endfor %}</aside><div>{% paginate collection.products by section.settings.products_per_page %}<div class="toolbar"><span>{{ collection.products_count }} Produkte</span><form><label for="sort">Sortieren: </label><select id="sort" name="sort_by" onchange="this.form.submit()">{% assign sort_by = collection.sort_by | default: collection.default_sort_by %}{% for option in collection.sort_options %}<option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>{% endfor %}</select></form></div><div class="grid grid--3">{% for product in collection.products %}{% render 'product-card', product: product %}{% else %}<p>In dieser Kollektion sind noch keine Produkte verfügbar.</p>{% endfor %}</div>{% if paginate.pages > 1 %}<div class="pagination">{{ paginate | default_pagination }}</div>{% endif %}{% endpaginate %}</div></div></section>
{% schema %}{"name":"Kollektion","settings":[{"type":"range","id":"products_per_page","label":"Produkte pro Seite","min":6,"max":24,"step":3,"default":12}]}{% endschema %}
