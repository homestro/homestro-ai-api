<section class="section page-width"><h1 class="section-title">Suche</h1><form class="search" action="{{ routes.search_url }}"><input name="q" value="{{ search.terms | escape }}" placeholder="Wonach suchen Sie?"><button type="submit">Suchen</button></form>{% if search.performed %}<p>{{ search.results_count }} Ergebnisse für „{{ search.terms }}“</p><div class="grid grid--4">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', product: item %}{% endif %}{% endfor %}</div>{% endif %}</section>{% schema %}{"name":"Suche","settings":[]}{% endschema %}
