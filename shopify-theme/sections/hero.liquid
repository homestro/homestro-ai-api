{% assign hero_image = section.settings.image %}
<section class="hero{% unless hero_image %} hero--placeholder{% endunless %}">
  <div class="hero__media">
    {% if hero_image %}
      {{ hero_image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '750,1100,1500,2000,2400', sizes: '100vw', alt: hero_image.alt | default: section.settings.heading }}
    {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
    {% endif %}
  </div>
  <div class="page-width hero__overlay">
    <div class="hero__content">
      {% if section.settings.eyebrow != blank %}<div class="eyebrow">{{ section.settings.eyebrow }}</div>{% endif %}
      <h1>{{ section.settings.heading }}</h1>
      {% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}
      <div class="hero__buttons">
        <a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
        <a class="button button--light" href="{{ section.settings.secondary_link | default: routes.collections_url }}">{{ section.settings.secondary_label }}</a>
      </div>
    </div>
  </div>
</section>
{% schema %}
{"name":"Lifestyle-Hero","settings":[{"type":"image_picker","id":"image","label":"Hero-Bild"},{"type":"text","id":"eyebrow","label":"Oberzeile","default":"Willkommen bei HOMESTRO"},{"type":"text","id":"heading","label":"Überschrift","default":"Alles, was du brauchst. Ein Shop."},{"type":"textarea","id":"text","label":"Text","default":"Entdecke ausgewählte Produkte für Alltag, Zuhause und Abenteuer."},{"type":"text","id":"button_label","label":"Erster Button","default":"Jetzt entdecken"},{"type":"url","id":"button_link","label":"Erster Link"},{"type":"text","id":"secondary_label","label":"Zweiter Button","default":"Kategorien entdecken"},{"type":"url","id":"secondary_link","label":"Zweiter Link"},{"type":"range","id":"desktop_position","label":"Horizontale Bildposition","min":0,"max":100,"step":5,"unit":"%","default":50}],"presets":[{"name":"Lifestyle-Hero"}]}
{% endschema %}
