<section class="hero"><div class="hero__grid"><div class="hero__content"><div class="eyebrow">{{ section.settings.eyebrow }}</div><h1>{{ section.settings.heading }}</h1><p>{{ section.settings.text }}</p><div class="hero__buttons"><a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>{% if section.settings.secondary_label != blank %}<a class="button button--secondary" href="{{ section.settings.secondary_link | default: routes.collections_url }}">{{ section.settings.secondary_label }}</a>{% endif %}</div></div><div class="hero__media">{% if section.settings.image %}{{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'eager', widths: '600,900,1200,1600', sizes: '(max-width: 800px) 100vw, 50vw', alt: section.settings.image.alt }}{% else %}{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}{% endif %}</div></div></section>
{% schema %}{"name":"Hero","settings":[{"type":"text","id":"eyebrow","label":"Oberzeile","default":"Schöner wohnen. Einfach gemacht."},{"type":"text","id":"heading","label":"Überschrift","default":"Lieblingsstücke für Ihr Zuhause"},{"type":"textarea","id":"text","label":"Text","default":"Entdecken Sie praktische, langlebige Wohnideen, die Alltag und Räume besser machen."},{"type":"text","id":"button_label","label":"Button","default":"Jetzt entdecken"},{"type":"url","id":"button_link","label":"Button-Link"},{"type":"text","id":"secondary_label","label":"Zweiter Button","default":"Bestseller ansehen"},{"type":"url","id":"secondary_link","label":"Zweiter Link"},{"type":"image_picker","id":"image","label":"Bild"}],"presets":[{"name":"Hero"}]}{% endschema %}
