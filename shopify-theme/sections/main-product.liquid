<section class="page-width"><nav class="breadcrumb"><a href="{{ routes.root_url }}">Startseite</a> / <a href="{{ product.collections.first.url | default: routes.all_products_collection_url }}">Produkte</a> / {{ product.title }}</nav><div class="product"><div class="product__gallery">{% for media in product.media %}{{ media.preview_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '450,700,1000', alt: media.alt }}{% else %}{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}{% endfor %}</div><div class="product__info"><div class="eyebrow">HOMESTRO Auswahl</div><h1 class="product__title">{{ product.title }}</h1>{% if section.settings.show_rating %}<div class="rating">★★★★★ <span style="color:var(--muted)">Bewährte Qualität</span></div>{% endif %}<div class="product__price price" data-product-price>{{ product.selected_or_first_available_variant.price | money }}{% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif %}</div><div class="rte">{{ product.description | truncatewords: 42 }}</div>{% form 'product', product, data-ajax-cart: '' %}{% unless product.has_only_default_variant %}<label for="variant-{{ section.id }}">Ausführung</label><select id="variant-{{ section.id }}" name="id" data-variant-select>{% for variant in product.variants %}<option value="{{ variant.id }}" data-price="{{ variant.price | money }}" data-available="{{ variant.available }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %}>{{ variant.title }}{% unless variant.available %} – Ausverkauft{% endunless %}</option>{% endfor %}</select>{% else %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">{% endunless %}<label for="quantity-{{ section.id }}">Menge</label><input class="quantity" id="quantity-{{ section.id }}" type="number" name="quantity" min="1" value="1"><button class="button" type="submit" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>{% if product.selected_or_first_available_variant.available %}In den Warenkorb{% else %}Ausverkauft{% endif %}</button>{% endform %}<div class="benefits"><div>✓ Kostenloser Versand ab 50 €</div><div>↺ 30 Tage Rückgaberecht</div><div>▣ Sichere, verschlüsselte Zahlung</div></div></div></div>{% if product.description != blank %}<div class="section"><h2 class="section-title">Details</h2><div class="rte">{{ product.description }}</div></div>{% endif %}</section>
{% schema %}{"name":"Produkt","settings":[{"type":"checkbox","id":"show_rating","label":"Bewertung anzeigen","default":true}]}{% endschema %}
