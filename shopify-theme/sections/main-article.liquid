<article class="section page-width rte"><nav class="breadcrumb"><a href="{{ blog.url }}">{{ blog.title }}</a> / {{ article.title }}</nav><h1 class="section-title">{{ article.title }}</h1><p>{{ article.published_at | date: '%d.%m.%Y' }}</p>{% if article.image %}{{ article.image | image_url: width: 1200 | image_tag: loading: 'eager', alt: article.title }}{% endif %}{{ article.content }}</article>{% schema %}{"name":"Artikel","settings":[]}{% endschema %}
