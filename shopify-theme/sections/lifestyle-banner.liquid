{% assign banner_image = section.settings.image %}
<section class="section lifestyle-wrap"><div class="page-width"><a class="lifestyle-banner" href="{{ section.settings.link | default: routes.collections_url }}">{% if banner_image %}{{ banner_image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '750,1200,1800,2400', sizes: '(max-width: 800px) 100vw, 1240px', alt: banner_image.alt | default: section.settings.heading }}{% else %}{{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder' }}{% endif %}<div class="lifestyle-banner__content"><h2>{{ section.settings.heading }}</h2>{% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}<span class="button">{{ section.settings.button_label }}</span></div></a></div></section>
{% schema %}
{"name":"Abschluss-Lifestyle-Banner","settings":[{"type":"image_picker","id":"image","label":"Bild"},{"type":"text","id":"heading","label":"Überschrift","default":"Mehr erleben. Jeden Tag."},{"type":"textarea","id":"text","label":"Text"},{"type":"text","id":"button_label","label":"Button","default":"Kollektionen entdecken"},{"type":"url","id":"link","label":"Link"}],"presets":[{"name":"Abschluss-Lifestyle-Banner"}]}
{% endschema %}
