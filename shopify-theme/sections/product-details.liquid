{% assign details_image = section.settings.image | default: product.media[1].preview_image %}
<section class="section product-story"><div class="page-width product-story__grid"><div class="product-story__copy"><div class="eyebrow">Details</div><h2 class="section-title">{{ section.settings.heading }}</h2>{% if product.description != blank %}<div class="rte">{{ product.description }}</div>{% else %}<p>Weitere Produktinformationen folgen.</p>{% endif %}</div><div class="product-story__media">{% if details_image %}{{ details_image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '500,800,1200,1600', sizes: '(max-width: 800px) 100vw, 50vw', alt: details_image.alt | default: product.title }}{% else %}{{ 'product-2' | placeholder_svg_tag: 'placeholder' }}{% endif %}</div></div></section>
{% schema %}
{"name":"Produktdetails mit Bild","settings":[{"type":"text","id":"heading","label":"Überschrift","default":"Beschreibung & Features"},{"type":"image_picker","id":"image","label":"Zweites Produkt- oder Lifestylebild (optional)"}]}
{% endschema %}
