<section class="section"><div class="page-width"><div class="section-head"><div><div class="eyebrow">{{ section.settings.eyebrow }}</div><h2 class="section-title">{{ section.settings.heading }}</h2></div>{% if section.settings.collection %}<a href="{{ section.settings.collection.url }}">Alle ansehen →</a>{% endif %}</div><div class="grid grid--4">{% for product in section.settings.collection.products limit: section.settings.limit %}{% render 'product-card', product: product %}{% else %}{% for i in (1..4) %}<article class="product-card"><div class="product-card__media">{{ 'product-' | append: i | placeholder_svg_tag: 'placeholder' }}</div><h3>Ihr Produkt</h3><div class="price">29,90 €</div></article>{% endfor %}{% endfor %}</div></div></section>
{% schema %}{"name":"Produktkollektion","settings":[{"type":"text","id":"eyebrow","label":"Oberzeile","default":"Von Kunden geliebt"},{"type":"text","id":"heading","label":"Überschrift","default":"Unsere Bestseller"},{"type":"collection","id":"collection","label":"Kollektion"},{"type":"range","id":"limit","label":"Anzahl","min":4,"max":12,"step":4,"default":8}],"presets":[{"name":"Produktkollektion"}]}{% endschema %}
