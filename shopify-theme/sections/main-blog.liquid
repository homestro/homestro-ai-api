<section class="section page-width"><h1 class="section-title">{{ blog.title }}</h1><div class="grid grid--3">{% paginate blog.articles by 12 %}{% for article in blog.articles %}<article class="feature">{% if article.image %}<a href="{{ article.url }}">{{ article.image | image_url: width: 700 | image_tag: loading: 'lazy', alt: article.title }}</a>{% endif %}<p class="eyebrow">{{ article.published_at | date: '%d.%m.%Y' }}</p><h2><a href="{{ article.url }}">{{ article.title }}</a></h2><p>{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p><a href="{{ article.url }}">Weiterlesen →</a></article>{% endfor %}{{ paginate | default_pagination }}{% endpaginate %}</div></section>{% schema %}{"name":"Blog","settings":[]}{% endschema %}
