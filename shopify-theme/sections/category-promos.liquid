<section class="section promo-section"><div class="page-width">
  <div class="section-head"><div><div class="eyebrow">HOMESTRO Welten</div><h2 class="section-title">{{ section.settings.heading }}</h2></div></div>
  <div class="promo-grid">{% for block in section.blocks %}{% assign destination = block.settings.collection %}{% assign promo_image = block.settings.image | default: destination.image %}<a class="promo-card" href="{{ block.settings.link | default: destination.url | default: routes.collections_url }}" {{ block.shopify_attributes }}>{% if promo_image %}{{ promo_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '500,800,1100,1400', sizes: '(max-width: 800px) 100vw, 33vw', alt: promo_image.alt | default: block.settings.heading }}{% else %}{{ 'lifestyle-' | append: forloop.index | placeholder_svg_tag: 'placeholder' }}{% endif %}<div class="promo-card__content"><h3>{{ block.settings.heading }}</h3>{% if block.settings.text != blank %}<p>{{ block.settings.text }}</p>{% endif %}<span class="button button--light">Entdecken</span></div></a>{% endfor %}</div>
</div></section>
{% schema %}
{"name":"Lifestyle-Promos","max_blocks":3,"settings":[{"type":"text","id":"heading","label":"Überschrift","default":"Für jeden Moment"}],"blocks":[{"type":"promo","name":"Promo","settings":[{"type":"image_picker","id":"image","label":"Bild"},{"type":"collection","id":"collection","label":"Kollektion (optional)"},{"type":"url","id":"link","label":"Eigenes Ziel (optional)"},{"type":"text","id":"heading","label":"Überschrift","default":"Active Life"},{"type":"text","id":"text","label":"Text","default":"Entdecke die Kollektion"}]}],"presets":[{"name":"Lifestyle-Promos","blocks":[{"type":"promo"},{"type":"promo"},{"type":"promo"}]}]}
{% endschema %}
