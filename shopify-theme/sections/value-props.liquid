<section class="section section--cream features"><div class="page-width"><div class="section-head"><div><div class="eyebrow">Das HOMESTRO Versprechen</div><h2 class="section-title">Mit gutem Gefühl einkaufen</h2></div></div><div class="grid grid--3">{% for block in section.blocks %}<div class="feature" {{ block.shopify_attributes }}><div class="feature__icon">{{ block.settings.icon }}</div><h3>{{ block.settings.heading }}</h3><p>{{ block.settings.text }}</p></div>{% endfor %}</div></div></section>
{% schema %}{"name":"Vorteile","blocks":[{"type":"feature","name":"Vorteil","settings":[{"type":"text","id":"icon","label":"Symbol","default":"♡"},{"type":"text","id":"heading","label":"Titel","default":"Sorgfältig ausgewählt"},{"type":"textarea","id":"text","label":"Text","default":"Produkte, die Funktion, Qualität und zeitloses Design verbinden."}]}],"presets":[{"name":"Vorteile","blocks":[{"type":"feature"},{"type":"feature","settings":{"icon":"♧","heading":"Für den Alltag gemacht"}},{"type":"feature","settings":{"icon":"✦","heading":"Service, der hilft"}}]}]}{% endschema %}
