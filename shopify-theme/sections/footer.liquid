<footer class="footer"><div class="page-width"><div class="footer__grid"><div><a class="footer__brand" href="{{ routes.root_url }}">HOMESTRO</a><p>{{ section.settings.about }}</p></div>{% for block in section.blocks %}<div {{ block.shopify_attributes }}><h3>{{ block.settings.title }}</h3><ul>{% for link in block.settings.menu.links %}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{% endfor %}</ul></div>{% endfor %}{% if section.settings.show_policies %}<div><h3>Rechtliches</h3><ul>{% for policy in shop.policies %}{% if policy != blank %}<li><a href="{{ policy.url }}">{{ policy.title }}</a></li>{% endif %}{% endfor %}</ul></div>{% endif %}</div><div class="footer__bottom"><span>© {{ 'now' | date: '%Y' }} {{ shop.name | default: 'HOMESTRO' }}</span><a href="{{ routes.contact_url | default: routes.root_url }}">Kontakt</a></div></div></footer>
{% schema %}
{"name":"Footer","max_blocks":2,"settings":[{"type":"textarea","id":"about","label":"Über uns","default":"Ausgewählte Produkte für Alltag, Zuhause und Abenteuer."},{"type":"checkbox","id":"show_policies","label":"Verfügbare Shopify-Richtlinien anzeigen","default":true}],"blocks":[{"type":"menu","name":"Menü","settings":[{"type":"text","id":"title","label":"Titel","default":"Service"},{"type":"link_list","id":"menu","label":"Menü"}]}],"presets":[{"name":"Footer","blocks":[{"type":"menu"},{"type":"menu"}]}]}
{% endschema %}
