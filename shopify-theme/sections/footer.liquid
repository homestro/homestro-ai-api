<footer class="footer"><div class="page-width"><div class="footer__grid"><div><a class="logo" style="color:white" href="{{ routes.root_url }}">HOMESTRO</a><p>{{ section.settings.about }}</p></div>{% for block in section.blocks %}<div {{ block.shopify_attributes }}><h3>{{ block.settings.title }}</h3><ul>{% for link in block.settings.menu.links %}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{% endfor %}</ul></div>{% endfor %}</div><div class="footer__bottom"><span>© {{ 'now' | date: '%Y' }} HOMESTRO. Alle Rechte vorbehalten.</span><span>Sicher bezahlen · SSL-verschlüsselt</span></div></div></footer>
{% schema %}{"name":"Footer","max_blocks":3,"settings":[{"type":"textarea","id":"about","label":"Über uns","default":"Durchdachte Produkte für ein Zuhause, das sich jeden Tag gut anfühlt."}],"blocks":[{"type":"menu","name":"Menü","settings":[{"type":"text","id":"title","label":"Titel","default":"Service"},{"type":"link_list","id":"menu","label":"Menü"}]}],"presets":[{"name":"Footer","blocks":[{"type":"menu"},{"type":"menu"},{"type":"menu"}]}]}{% endschema %}
