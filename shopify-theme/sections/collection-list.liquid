<section class="section category-section"><div class="page-width"><div class="section-head"><div><div class="eyebrow">Für jeden Raum</div><h2 class="section-title">{{ section.settings.heading }}</h2></div></div><div class="grid grid--3">{% for block in section.blocks %}{% assign collection = block.settings.collection %}<a class="collection-card" href="{{ collection.url | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>{% assign card_image = collection.image | default: collection.products.first.featured_image %}{% if card_image == blank and collection.handle == 'kuche-essen' %}{% assign card_image = all_products['kitchen-sink-holder-hanging-drain-basket-adjustable-soap-sponge-shelf-organizer-bathroom-faucet-holder-rack-kitchen-accessories'].featured_image %}{% endif %}{% if collection.handle == 'garten-heimwerken' %}{% assign card_image = all_products['fruchtfliegenfalle-flaschenfalle-garten-obstbaum'].featured_image | default: collection.image %}{% endif %}{% if card_image %}{{ card_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,700,900', alt: collection.title }}{% else %}{{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'placeholder' }}{% endif %}<div class="collection-card__overlay"><h3>{{ collection.title | default: block.settings.title }}</h3><span>Entdecken →</span></div></a>{% endfor %}</div></div></section>
{% schema %}{"name":"Kollektionen","settings":[{"type":"text","id":"heading","label":"Überschrift","default":"Entdecken Sie unsere Welten"}],"blocks":[{"type":"collection","name":"Kollektion","settings":[{"type":"collection","id":"collection","label":"Kollektion"},{"type":"text","id":"title","label":"Ersatztitel","default":"Schöner wohnen"}]}],"presets":[{"name":"Kollektionen","blocks":[{"type":"collection"},{"type":"collection"},{"type":"collection"}]}]}{% endschema %}

