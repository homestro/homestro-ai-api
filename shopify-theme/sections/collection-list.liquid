<section class="section section--cream"><div class="page-width"><div class="section-head"><div><div class="eyebrow">Für jeden Raum</div><h2 class="section-title">{{ section.settings.heading }}</h2></div></div><div class="grid grid--3">{% for block in section.blocks %}{% assign collection = block.settings.collection %}<a class="collection-card" href="{{ collection.url | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>{% if collection.image %}{{ collection.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,700,900', alt: collection.title }}{% else %}{{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'placeholder' }}{% endif %}<div class="collection-card__overlay"><h3>{{ collection.title | default: block.settings.title }}</h3><span>Entdecken →</span></div></a>{% endfor %}</div></div></section>
{% schema %}{"name":"Kollektionen","settings":[{"type":"text","id":"heading","label":"Überschrift","default":"Entdecken Sie unsere Welten"}],"blocks":[{"type":"collection","name":"Kollektion","settings":[{"type":"collection","id":"collection","label":"Kollektion"},{"type":"text","id":"title","label":"Ersatztitel","default":"Schöner wohnen"}]}],"presets":[{"name":"Kollektionen","blocks":[{"type":"collection"},{"type":"collection"},{"type":"collection"}]}]}{% endschema %}
