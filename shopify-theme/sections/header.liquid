<header class="header"><div class="page-width header__row"><button class="mobile-toggle" data-menu-toggle aria-expanded="false" aria-controls="navigation" aria-label="Menü öffnen">☰</button><a class="logo" href="{{ routes.root_url }}">{% if section.settings.logo != blank %}{{ section.settings.logo | image_url: width: 320 | image_tag: widths: '160,240,320', alt: shop.name }}{% else %}HOMESTRO{% endif %}</a><form class="search" action="{{ routes.search_url }}" role="search"><input name="q" type="search" value="{{ search.terms | escape }}" placeholder="Produkte und Kategorien durchsuchen …" aria-label="Shop durchsuchen"><button aria-label="Suchen">⌕</button></form><div class="header__actions"><a class="icon-link hide-mobile" href="{{ routes.account_url }}">♙ <span>Konto</span></a><a class="icon-link" href="{{ routes.cart_url }}" aria-label="Warenkorb">▣ <span class="hide-mobile">Warenkorb</span> <span class="cart-count" data-cart-count>{{ cart.item_count }}</span></a></div></div><nav id="navigation" class="nav" data-nav><div class="page-width nav__inner">{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% else %}<a href="{{ routes.all_products_collection_url }}">Alle Produkte</a><a href="/collections/wohnen">Wohnen</a><a href="/collections/kueche">Küche</a><a href="/collections/ordnung">Ordnung</a><a href="/collections/garten">Garten</a>{% endfor %}</div></nav></header>
{% schema %}{"name":"Header","settings":[{"type":"image_picker","id":"logo","label":"Logo"},{"type":"link_list","id":"menu","label":"Hauptmenü"}]}{% endschema %}
