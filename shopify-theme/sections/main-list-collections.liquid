<section class="section page-width"><div class="section-head"><h1 class="section-title">Alle Kollektionen</h1></div><div class="grid grid--3">{% for collection in collections %}<a class="collection-card" href="{{ collection.url }}">{% if collection.image %}{{ collection.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: collection.title }}{% else %}{{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}{% endif %}<div class="collection-card__overlay"><h2>{{ collection.title }}</h2><span>{{ collection.products_count }} Produkte →</span></div></a>{% endfor %}</div></section>{% schema %}{"name":"Alle Kollektionen","settings":[]}{% endschema %}
