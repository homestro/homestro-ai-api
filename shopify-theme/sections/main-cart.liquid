<section class="page-width cart-page"><nav class="breadcrumb"><a href="{{ routes.root_url }}">Startseite</a> / Warenkorb</nav><h1 class="section-title">Ihr Warenkorb</h1>{% if cart.empty? %}<div class="empty"><h2>Ihr Warenkorb ist leer</h2><p>Entdecken Sie praktische Lieblingsstücke für Ihr Zuhause.</p><a class="button" href="{{ routes.all_products_collection_url }}">Weiter einkaufen</a></div>{% else %}<form action="{{ routes.cart_url }}" method="post">{% for item in cart.items %}<div class="cart-row"><a href="{{ item.url }}">{{ item.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: item.title }}</a><div><a href="{{ item.url }}"><strong>{{ item.product.title }}</strong></a><div>{{ item.variant.title }}</div><a href="{{ item.url_to_remove }}">Entfernen</a></div><input class="quantity" type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Menge für {{ item.title }}"><strong>{{ item.final_line_price | money }}</strong></div>{% endfor %}<div class="cart-summary"><p>Zwischensumme <strong style="float:right">{{ cart.total_price | money }}</strong></p><p>Versand und Steuern werden beim Checkout berechnet.</p><button class="button button--secondary" type="submit" name="update">Warenkorb aktualisieren</button><button class="button" type="submit" name="checkout">Sicher zur Kasse</button></div></form>{% endif %}</section>
{% schema %}{"name":"Warenkorb","settings":[]}{% endschema %}
