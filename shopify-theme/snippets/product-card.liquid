{% assign card_price = product.selected_variant.price | default: product.price %}
{% assign card_compare_price = product.selected_variant.compare_at_price | default: product.compare_at_price %}
<article class="product-card">{% if card_compare_price > card_price %}<span class="badge">Angebot</span>{% endif %}<a href="{{ product.url }}"><div class="product-card__media">{% if product.featured_image %}{{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '240,360,500,700', sizes: '(max-width: 480px) 50vw, 25vw', alt: product.featured_image.alt }}{% else %}{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}{% endif %}</div><h3>{{ product.title }}</h3><div class="price">{% if product.price_varies and product.selected_variant == blank %}Ab {% endif %}{{ card_price | money }}{% if card_compare_price > card_price %}<s>{{ card_compare_price | money }}</s>{% endif %}</div></a>
{% if product.available %}
  {% if product.variants.size == 1 %}
    {% assign card_variant = product.variants.first %}
    <form method="post" action="{{ routes.cart_add_url }}" data-ajax-cart>
      <input type="hidden" name="id" value="{{ card_variant.id }}">
      <input type="hidden" name="quantity" value="1">
      <button class="button" type="submit" data-add-to-cart data-available="true">In den Warenkorb</button>
      <p class="form-message" data-product-form-message role="alert" hidden></p>
    </form>
  {% else %}
    <a class="button button--secondary" href="{{ product.url }}">Ausführung wählen</a>
  {% endif %}
{% else %}
  <button class="button" type="button" disabled>Ausverkauft</button>
{% endif %}
</article>
