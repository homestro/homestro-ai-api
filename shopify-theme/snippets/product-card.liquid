<article class="product-card">{% if product.compare_at_price > product.price %}<span class="badge">Angebot</span>{% endif %}<a href="{{ product.url }}"><div class="product-card__media">{% if product.featured_image %}{{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '240,360,500,700', sizes: '(max-width: 480px) 50vw, 25vw', alt: product.featured_image.alt }}{% else %}{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}{% endif %}</div><h3>{{ product.title }}</h3><div class="price">{{ product.price | money }}{% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif %}</div></a></article>
