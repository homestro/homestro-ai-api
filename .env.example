# Copy to .env on the host and keep .env out of Git. Generate a unique 40+ char key.
PILOT_ADMIN_KEY=
PILOT_HTTP_PORT=8080

# Dry-run is on by default. Micro-budget is a separate one-campaign path.
DRY_RUN=True
MARKETING_BUDGET_LIMIT=0.0
ALLOW_MICRO_BUDGET=false
MICRO_BUDGET_PRODUCT_ID=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PIXEL_ID=
META_PAGE_ID=
META_API_VERSION=v26.0
META_BILLING_VERIFIED=false
META_PURCHASE_EVENT_VERIFIED=false
PILOT_AD_DRY_RUN=true
PILOT_AD_MAX_BUDGET_EUR=0

# Live campaign publishing remains blocked until all explicit preflight flags pass.
PILOT_AUTOPILOT_ENABLED=false
PILOT_CREATIVE_ENABLED=false
PILOT_CREATIVE_MIN_SCORE=85
PILOT_CREATIVE_DIR=/data/adtech-creatives
HOMESTRO_LOGO_URL=
HOMESTRO_BRAND_PRIMARY=#246B4B
HOMESTRO_BRAND_SECONDARY=#F2EFE7
HOMESTRO_BRAND_ACCENT=#D8A83E
PILOT_DAEMON_ENABLED=true
HOMESTRO_PRODUCT_FEED_URL=
GMC_MERCHANT_ID=
GMC_SERVICE_ACCOUNT_JSON=
PILOT_GITHUB_TOKEN=
PILOT_GITHUB_REPOSITORY=homestro/homestro-ai-api
PILOT_GITHUB_PR_NUMBER=104
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
META_AD_LIBRARY_ACCESS_TOKEN=
