# Copy to .env on the host and keep .env out of Git. Generate a unique 40+ char key.
PILOT_ADMIN_KEY=
PILOT_HTTP_PORT=8080

# Intentionally hard-coded to safe values in docker-compose.yml as well.
DRY_RUN=True
MARKETING_BUDGET_LIMIT=0.0
PILOT_AD_DRY_RUN=true
PILOT_AD_MAX_BUDGET_EUR=0

# No provider publishing or campaign mutation adapters are enabled by this deployment.
PILOT_AUTOPILOT_ENABLED=false
PILOT_CREATIVE_ENABLED=false
PILOT_CREATIVE_MIN_SCORE=85
ALLOW_MICRO_BUDGET=false
MICRO_BUDGET_PRODUCT_ID=
PILOT_DAEMON_ENABLED=true
HOMESTRO_PRODUCT_FEED_URL=
GMC_MERCHANT_ID=
GMC_SERVICE_ACCOUNT_JSON=
PILOT_GITHUB_TOKEN=
PILOT_GITHUB_REPOSITORY=homestro/homestro-ai-api
PILOT_GITHUB_PR_NUMBER=104
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
META_AD_LIBRARY_ACCESS_TOKEN=
